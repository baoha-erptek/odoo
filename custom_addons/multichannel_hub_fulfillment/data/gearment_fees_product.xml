<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    ESTY-246 — service product used for the "Gearment shipping & fees" line that
    action_request_gearment_quote adds to a dropship PO. Carries the order-level
    shipping + handling + tax + fees portion of a Gearment quote so the PO total
    equals the Gearment cost and standard Purchase reporting tracks the spend.
    Seeded as product.product so the xmlid resolves to a variant (PO lines carry
    product.product); delegation inheritance auto-creates its template.
  -->
  <data noupdate="1">
    <record id="product_gearment_fees" model="product.product">
      <field name="name">Gearment Shipping &amp; Fees</field>
      <field name="type">service</field>
      <field name="purchase_ok" eval="True"/>
      <field name="sale_ok" eval="False"/>
      <field name="default_code">GEARMENT-FEES</field>
      <field name="list_price">0.0</field>
      <field name="description">Non-inventory line carrying the shipping/handling/tax/fees portion of a Gearment price quote on a dropship purchase order (ESTY-246). Do not sell.</field>
    </record>
  </data>
</odoo>

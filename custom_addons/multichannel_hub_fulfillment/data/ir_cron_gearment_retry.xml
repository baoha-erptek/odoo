<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="ir_cron_gearment_retry_stalled" model="ir.cron">
      <field name="name">P1-DESIGN+GEARMENT — Retry stalled Gearment pushes</field>
      <field name="model_id" ref="sale.model_sale_order"/>
      <field name="state">code</field>
      <field name="code">model._cron_retry_stalled_gearment_pushes()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="True"/>
    </record>

    <record id="icp_gearment_auto_push_enabled" model="ir.config_parameter">
      <field name="key">multichannel_hub_fulfillment.gearment_auto_push_enabled</field>
      <field name="value">True</field>
    </record>

  </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_config_parameter_api_log_retention_days" model="ir.config_parameter">
      <field name="key">multichannel_hub_fulfillment.api_log_retention_days</field>
      <field name="value">30</field>
    </record>
    <record id="ir_cron_gearment_api_log_cleanup" model="ir.cron">
      <field name="name">Gearment API Log: cleanup old rows</field>
      <field name="model_id" ref="model_gearment_api_log"/>
      <field name="state">code</field>
      <field name="code">model._cron_cleanup_old_logs()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>

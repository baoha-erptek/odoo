<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Daily cleanup of old gearment.api.log rows (P0-18b1) -->
    <record id="ir_cron_cleanup_gearment_api_log" model="ir.cron">
        <field name="name">Cleanup old Gearment API logs</field>
        <field name="model_id" ref="multichannel_hub_fulfillment.model_gearment_api_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_logs()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        P4-01-D D5 — "Sync to Gearment" button + Gearment notebook tab on
        sale.order form. Visibility per DD4.b (Odoo 19 native expression
        syntax): button visible iff sales_channel='etsy' AND
        x_gearment_outbound_ref empty AND outbound_state in
        {draft, quoted, operator_review}. Group-gated to group_ba_shipping.
    -->
    <record id="view_order_form_gearment_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.gearment.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- D5: button on the header bar -->
            <xpath expr="//header" position="inside">
                <button name="action_get_gearment_quote"
                        type="object"
                        string="Sync to Gearment"
                        groups="multichannel_hub_fulfillment.group_ba_shipping"
                        invisible="sales_channel != 'etsy' or x_gearment_outbound_ref or x_gearment_outbound_state not in ('draft', 'quoted', 'operator_review')"/>
                <button name="action_open_gearment_quote_wizard"
                        type="object"
                        string="Review Quote"
                        groups="multichannel_hub_fulfillment.group_ba_shipping"
                        invisible="x_gearment_outbound_state != 'quoted'"/>
            </xpath>

            <!-- D5: Gearment notebook tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Gearment" name="gearment_tab"
                      invisible="sales_channel != 'etsy'">
                    <group>
                        <group string="Outbound State">
                            <field name="x_gearment_outbound_state"/>
                            <field name="x_gearment_outbound_ref" readonly="1"/>
                            <field name="x_gearment_pushed_at" readonly="1"/>
                            <field name="x_gearment_status" readonly="1"/>
                        </group>
                        <group string="Quote">
                            <field name="x_gearment_quote_currency" readonly="1"/>
                            <field name="x_gearment_quote_total" readonly="1"
                                   widget="monetary"/>
                            <field name="x_gearment_quote_expires_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Quote Breakdown">
                        <field name="x_gearment_quote_breakdown_json"
                               nolabel="1" widget="text" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        P4-01-D D3 — bulk "Sync to Gearment" server action bound to the
        sale.order.line list view (Operations Dashboard, P1-01b).
        Lives in mhf (not mhc) per ADR-003: Gearment is fulfillment-
        specific. Method action_gearment_bulk_sync (sale_order_line.py)
        dedupes orders, per-order savepoint, FR-017 12th gate, bus.bus
        progress notifications.
    -->
    <record id="action_server_gearment_bulk_sync" model="ir.actions.server">
        <field name="name">Sync to Gearment</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="binding_model_id" ref="sale.model_sale_order_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_gearment_bulk_sync()</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- P1-DROP-SEED: surface x_gearment_sku on the product form so operators
         can set it and immediately see Dropship route + Gearment seller appear
         (via @api.onchange + write() override on product.template). -->
    <record id="product_template_form_view_gearment" model="ir.ui.view">
        <field name="name">product.template.form.gearment.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_gearment_sku"/>
            </xpath>
        </field>
    </record>
</odoo>

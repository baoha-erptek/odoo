<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="group_ba_shipping" model="res.groups">
      <field name="name">BA Shipping Operator</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="comment">Uploads GKE Excel, runs preview + import. Cannot approve new schemas.</field>
    </record>

    <record id="group_ba_manager" model="res.groups">
      <field name="name">BA Shipping Manager</field>
      <field name="implied_ids" eval="[(4, ref('group_ba_shipping')), (4, ref('base.group_user'))]"/>
      <field name="comment">Approves new GKE schema fingerprints (FR-017 RPC-gated).</field>
    </record>

  </data>
</odoo>

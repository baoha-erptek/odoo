<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_design" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.design</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
        <block title="Design Orders" name="design_setting_container">
          <setting id="design_auto_create_setting"
                   string="Auto-create design order on confirmation"
                   help="Create a design order automatically when a sale order is confirmed.">
            <field name="design_auto_create_on_confirm"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- ESTY-244: multi-company isolation for design orders. Global rule
         (applies to every group with access) — mirrors standard Odoo
         company-isolation rules. -->
    <record id="design_order_company_rule" model="ir.rule">
      <field name="name">Design Order: multi-company</field>
      <field name="model_id" ref="model_design_order"/>
      <field name="global" eval="True"/>
      <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
  </data>
</odoo>

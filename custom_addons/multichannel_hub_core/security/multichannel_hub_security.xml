<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Production Team — generic, channel-agnostic.
            Owns design.file approval workflow (P1-02a) and the future
            production dashboards (P2-03 Process Dashboard).

            Distinct from the BA-tier groups in etsy_integration
            (group_marketing_user / group_ba_user / group_ba_lead, P1-04).
            BA approves customer-facing changes; Production approves
            internal manufacturing inputs.
        -->
        <record id="group_production_team" model="res.groups">
            <field name="name">Production Team</field>
            <field name="comment">Members of the production team. Approve / reject design files; will own the Process Dashboard once P2-03 lands.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- P1-PIPELINE-MIN seed pipelines (3 default routes per ADR-010 §9). -->
    <record id="order_pipeline_vn_internal_production" model="order.pipeline">
      <field name="name">Vietnam Internal Production</field>
      <field name="code">vn_internal_production</field>
      <field name="sequence">10</field>
      <field name="is_active" eval="True"/>
      <field name="channel_hint">internal</field>
      <field name="description">Default route for products manufactured at the Vietnam internal facility (17-stage SRS pipeline; full state machine lands in P1-PIPELINE-FULL).</field>
    </record>
    <record id="order_pipeline_gearment_pod" model="order.pipeline">
      <field name="name">Gearment Print-On-Demand</field>
      <field name="code">gearment_pod</field>
      <field name="sequence">20</field>
      <field name="is_active" eval="True"/>
      <field name="channel_hint">gearment</field>
      <field name="description">Drop-ship via Gearment partner API (P0-18b1/b2/P4-01). Orders flow: draft → quote → confirm → callback tracking. Use for products without internal capacity.</field>
    </record>
    <record id="order_pipeline_multi_technique_hybrid" model="order.pipeline">
      <field name="name">Multi-Technique Hybrid</field>
      <field name="code">multi_technique_hybrid</field>
      <field name="sequence">30</field>
      <field name="is_active" eval="True"/>
      <field name="channel_hint">hybrid</field>
      <field name="description">Mixed internal + external production for products requiring multiple techniques (e.g., DTF print at internal + embroidery at partner). Manual coordination for now.</field>
    </record>

    <!-- ICP system-wide default — falls back to vn_internal_production. -->
    <record id="ir_config_parameter_multichannel_hub_default_pipeline_code" model="ir.config_parameter">
      <field name="key">multichannel_hub.default_pipeline_code</field>
      <field name="value">vn_internal_production</field>
    </record>
  </data>
</odoo>

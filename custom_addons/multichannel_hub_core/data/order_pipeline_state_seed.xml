<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- pipeline.team seed (3 default teams). -->
    <record id="pipeline_team_internal_production" model="pipeline.team">
      <field name="name">Internal Production Team</field>
      <field name="code">internal_production</field>
      <field name="sequence">10</field>
    </record>
    <record id="pipeline_team_drop_ship_liaison" model="pipeline.team">
      <field name="name">Drop-Ship Liaison</field>
      <field name="code">drop_ship_liaison</field>
      <field name="sequence">20</field>
    </record>
    <record id="pipeline_team_qa_release" model="pipeline.team">
      <field name="name">QA &amp; Release</field>
      <field name="code">qa_release</field>
      <field name="sequence">30</field>
    </record>

    <!-- vn_internal_production stages (5-stage compact; 17-stage detail
         lands in a future runtime config push). -->
    <record id="state_vn_pending_file" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">pending_file</field>
      <field name="name">Chờ File</field>
      <field name="sequence">10</field>
      <field name="is_initial" eval="True"/>
      <field name="color">3</field>
      <field name="team_id" ref="pipeline_team_internal_production"/>
    </record>
    <record id="state_vn_in_production" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">in_production</field>
      <field name="name">Đang Sản Xuất</field>
      <field name="sequence">20</field>
      <field name="color">4</field>
      <field name="team_id" ref="pipeline_team_internal_production"/>
    </record>
    <record id="state_vn_packed" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">packed</field>
      <field name="name">Đã Đóng Gói</field>
      <field name="sequence">30</field>
      <field name="color">5</field>
      <field name="team_id" ref="pipeline_team_qa_release"/>
    </record>
    <record id="state_vn_shipped" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">shipped</field>
      <field name="name">Đã Gửi</field>
      <field name="sequence">40</field>
      <field name="color">10</field>
      <field name="team_id" ref="pipeline_team_qa_release"/>
    </record>
    <record id="state_vn_done" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">done</field>
      <field name="name">Hoàn Thành</field>
      <field name="sequence">50</field>
      <field name="is_terminal" eval="True"/>
      <field name="color">7</field>
    </record>
    <!-- P-D3-PIPELINE-UI (Flow 4 #3) — reprint loop. A completed order can be
         sent back to production for a re-print ("In Lại"); it then re-enters
         the in_production stage. New record → lands on upgrade even under the
         noupdate=1 block. -->
    <record id="state_vn_reprint" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_vn_internal_production"/>
      <field name="code">reprint</field>
      <field name="name">In Lại</field>
      <field name="sequence">60</field>
      <field name="color">1</field>
      <field name="team_id" ref="pipeline_team_internal_production"/>
      <field name="next_state_ids" eval="[(4, ref('state_vn_in_production'))]"/>
    </record>

    <!-- gearment_pod stages (4 stages mapping to draft/quote/confirm/ship cycle). -->
    <record id="state_gearment_draft" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_gearment_pod"/>
      <field name="code">draft</field>
      <field name="name">Draft</field>
      <field name="sequence">10</field>
      <field name="is_initial" eval="True"/>
      <field name="color">2</field>
      <field name="team_id" ref="pipeline_team_drop_ship_liaison"/>
    </record>
    <record id="state_gearment_quoted" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_gearment_pod"/>
      <field name="code">quoted</field>
      <field name="name">Quoted</field>
      <field name="sequence">20</field>
      <field name="color">3</field>
      <field name="team_id" ref="pipeline_team_drop_ship_liaison"/>
    </record>
    <record id="state_gearment_confirmed" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_gearment_pod"/>
      <field name="code">confirmed</field>
      <field name="name">Confirmed</field>
      <field name="sequence">30</field>
      <field name="color">4</field>
      <field name="team_id" ref="pipeline_team_drop_ship_liaison"/>
    </record>
    <record id="state_gearment_shipped" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_gearment_pod"/>
      <field name="code">shipped</field>
      <field name="name">Shipped</field>
      <field name="sequence">40</field>
      <field name="is_terminal" eval="True"/>
      <field name="color">10</field>
    </record>

    <!-- multi_technique_hybrid stages (3 stages). -->
    <record id="state_hybrid_setup" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_multi_technique_hybrid"/>
      <field name="code">setup</field>
      <field name="name">Setup</field>
      <field name="sequence">10</field>
      <field name="is_initial" eval="True"/>
      <field name="color">2</field>
    </record>
    <record id="state_hybrid_production" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_multi_technique_hybrid"/>
      <field name="code">production</field>
      <field name="name">Production</field>
      <field name="sequence">20</field>
      <field name="color">4</field>
    </record>
    <record id="state_hybrid_done" model="order.pipeline.state">
      <field name="pipeline_id" ref="order_pipeline_multi_technique_hybrid"/>
      <field name="code">done</field>
      <field name="name">Done</field>
      <field name="sequence">30</field>
      <field name="is_terminal" eval="True"/>
      <field name="color">7</field>
    </record>

  </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- P1-01a crons. Both run as base.user_root because they are
         system-maintenance jobs that must touch every order regardless
         of which group owns it; running as a salesman would
         silently skip rows whose record rules deny that user. The
         cron methods only set boolean stored-compute fields (no PII
         exposure, no return to client). -->

    <!-- recompute is_overdue_approval daily so the Order Dashboard's
         overdue marker reflects deadlines that tipped over purely
         from the calendar advancing (no DB write triggered the
         @api.depends chain). -->
    <record id="cron_recompute_overdue_approval" model="ir.cron">
        <field name="name">Multichannel Hub: recompute is_overdue_approval</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_overdue_approval()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- P1-01a — recompute is_duplicate_buyer daily so the retroactive
         flag on the older sibling flips True without paying O(N²) at
         create() time. -->
    <record id="cron_recompute_duplicate_buyer" model="ir.cron">
        <field name="name">Multichannel Hub: recompute is_duplicate_buyer</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_duplicate_buyer()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- P1-DESIGN-AUTO-GDRIVE — promote approved storage_mode='small'
         design files to GDrive every 5 minutes. Killswitch via ICP
         multichannel_hub.design_gdrive_auto_sync_enabled (default True).
         No-op when ICP design_file_default_gdrive_folder_id is unset. -->
    <record id="cron_design_file_gdrive_sync" model="ir.cron">
        <field name="name">Multichannel Hub: sync approved design files to GDrive</field>
        <field name="model_id" ref="model_design_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_approved_to_gdrive()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<!--
    SKU variant-attribute seed per SKU_GRAMMAR.md §8 + §3/§4/§5.

    7 product.attribute rows + values with x_code populated. Size values
    carry x_namespace + x_applicable_family_ids xml-id refs (§4 gating).

    noupdate="1" so admin edits persist.
    Spec 009 §2.5 P-HUB-SKU-BUILDER T041.
-->
<odoo noupdate="1">

    <!-- ============================================================== -->
    <!-- Attributes (7)                                                  -->
    <!-- ============================================================== -->

    <record id="attribute_family_tag" model="product.attribute">
        <field name="name">Family</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">radio</field>
        <field name="sequence">1</field>
    </record>
    <record id="attribute_material" model="product.attribute">
        <field name="name">Material</field>
        <field name="create_variant">always</field>
        <field name="display_type">select</field>
        <field name="sequence">2</field>
    </record>
    <record id="attribute_shape" model="product.attribute">
        <field name="name">Shape</field>
        <field name="create_variant">always</field>
        <field name="display_type">select</field>
        <field name="sequence">3</field>
    </record>
    <record id="attribute_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="create_variant">always</field>
        <field name="display_type">select</field>
        <field name="sequence">4</field>
    </record>
    <record id="attribute_fluid_oz" model="product.attribute">
        <field name="name">Fluid oz</field>
        <field name="create_variant">always</field>
        <field name="display_type">select</field>
        <field name="sequence">5</field>
    </record>
    <record id="attribute_apparel_size" model="product.attribute">
        <field name="name">Apparel Size</field>
        <field name="create_variant">always</field>
        <field name="display_type">select</field>
        <field name="sequence">6</field>
    </record>
    <record id="attribute_color" model="product.attribute">
        <field name="name">Color</field>
        <field name="create_variant">dynamic</field>
        <field name="display_type">color</field>
        <field name="sequence">7</field>
    </record>


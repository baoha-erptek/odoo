<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_multichannel_enquiry_close_wizard_form" model="ir.ui.view">
        <field name="name">multichannel.enquiry.close.wizard.form</field>
        <field name="model">multichannel.enquiry.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Enquiry">
                <group>
                    <field name="enquiry_id" readonly="1"/>
                    <field name="reason"/>
                    <field name="notes" placeholder="Optional close notes (added to enquiry chatter)"/>
                </group>
                <footer>
                    <button name="action_close"
                            string="Close Enquiry"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_multichannel_enquiry_close_wizard" model="ir.actions.act_window">
        <field name="name">Close Enquiry</field>
        <field name="res_model">multichannel.enquiry.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_multichannel_enquiry_close_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

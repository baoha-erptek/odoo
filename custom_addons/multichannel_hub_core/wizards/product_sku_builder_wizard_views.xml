<?xml version="1.0" encoding="utf-8"?>
<!-- Spec 009 §2.5 P-HUB-SKU-BUILDER T046 — 4-step wizard form. -->
<odoo>
    <record id="view_product_sku_builder_wizard_form" model="ir.ui.view">
        <field name="name">product.sku.builder.wizard.form</field>
        <field name="model">product.sku.builder.wizard</field>
        <field name="arch" type="xml">
            <form string="Build SKU &amp; Create Product">
                <header>
                    <field name="step" widget="statusbar"
                           statusbar_visible="1,2,3,4"/>
                </header>
                <sheet>
                    <!-- Step 1: Family -->
                    <group string="Step 1 — Family" invisible="step != '1'">
                        <field name="product_name" placeholder="Product display name (e.g. 'Custom Engraved Mug')"/>
                        <field name="family_id_auto" readonly="True"
                               string="Auto-classified"/>
                        <field name="family_id" options="{'no_create': True}"/>
                    </group>

                    <!-- Step 2: Material -->
                    <group string="Step 2 — Material" invisible="step != '2'">
                        <field name="material_id" options="{'no_create': True}"/>
                    </group>

                    <!-- Step 3: Size -->
                    <group string="Step 3 — Size" invisible="step != '3'">
                        <field name="_is_size_extractable" invisible="1"/>
                        <field name="size_id" options="{'no_create': True}"/>
                        <separator string="OR enter rectangular dimensions (doormat/rug):"/>
                        <field name="rect_w"/>
                        <field name="rect_h"/>
                    </group>
                    <!-- P-HUB-MISSING-INFO-WIZARD T071 — conditional
                         Step 3 fallback when the product name carries no
                         token in the family's expected SIZE namespace. -->
                    <group string="Size not detected — enter manually"
                           invisible="step != '3' or _is_size_extractable">
                        <field name="size_id_manual" options="{'no_create': True}"/>
                        <separator string="OR enter rectangular dimensions manually:"/>
                        <field name="rect_w_manual"/>
                        <field name="rect_h_manual"/>
                    </group>

                    <!-- Step 4: Preview -->
                    <group string="Step 4 — Preview &amp; Create" invisible="step != '4'">
                        <field name="var2_color_id" options="{'no_create': True}"
                               string="Color (optional)"/>
                        <field name="preview_sku" readonly="True"
                               string="Assembled SKU"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_prev" type="object"
                            string="Back" class="btn-secondary"
                            invisible="step == '1'"/>
                    <button name="action_next" type="object"
                            string="Next" class="btn-primary"
                            invisible="step == '4'"/>
                    <button name="action_create" type="object"
                            string="Create Product" class="btn-primary"
                            invisible="step != '4'"
                            groups="multichannel_hub_core.group_ba_user"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_sku_builder_wizard" model="ir.actions.act_window">
        <field name="name">Build SKU &amp; Create Product</field>
        <field name="res_model">product.sku.builder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

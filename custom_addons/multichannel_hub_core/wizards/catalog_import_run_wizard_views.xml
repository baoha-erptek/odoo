<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_import_run_wizard_form" model="ir.ui.view">
        <field name="name">catalog.import.run.wizard.form</field>
        <field name="model">catalog.import.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Catalog Excel">
                <sheet>
                    <group>
                        <field name="source_file" filename="source_filename"/>
                        <field name="source_filename" invisible="1"/>
                        <field name="mode"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Run Import" class="btn-primary"
                            groups="multichannel_hub_core.group_ba_user"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_catalog_import_run_wizard" model="ir.actions.act_window">
        <field name="name">Import Catalog Excel</field>
        <field name="res_model">catalog.import.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_catalog_import_run_history" model="ir.actions.act_window">
        <field name="name">Catalog Import History</field>
        <field name="res_model">product.catalog.import.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_catalog_import_run_wizard"
              name="Import Catalog Excel"
              parent="menu_operations_config"
              action="action_catalog_import_run_wizard"
              sequence="75"/>

    <menuitem id="menu_catalog_import_run_history"
              name="Catalog Import History"
              parent="menu_operations_config"
              action="action_catalog_import_run_history"
              sequence="76"/>
</odoo>

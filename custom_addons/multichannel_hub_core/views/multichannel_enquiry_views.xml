<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view -->
    <record id="view_multichannel_enquiry_form" model="ir.ui.view">
        <field name="name">multichannel.enquiry.form</field>
        <field name="model">multichannel.enquiry</field>
        <field name="arch" type="xml">
            <form string="Customer Enquiry">
                <header>
                    <button name="action_qualify"
                            string="Qualify"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'new'"
                            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager,multichannel_hub_core.group_ba_lead"/>
                    <button name="action_convert_to_quote"
                            string="Convert to Quote"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('new', 'qualified')"
                            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager,multichannel_hub_core.group_ba_lead"/>
                    <button name="%(action_multichannel_enquiry_close_wizard)d"
                            string="Close"
                            type="action"
                            invisible="state in ('converted', 'closed')"
                            context="{'default_enquiry_id': id}"
                            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager,multichannel_hub_core.group_ba_lead"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,qualified,converted,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="partner_email"/>
                            <field name="subject"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <!-- etsy_shop_id + etsy_conversation_id surface
                                 in etsy_integration view extension per
                                 ADR-003 -->
                            <field name="assigned_user_id"/>
                            <field name="converted_order_id"
                                   invisible="state != 'converted'"/>
                            <field name="converted_at"
                                   invisible="state != 'converted'"/>
                            <field name="closed_reason"
                                   invisible="state != 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes (not visible to buyer)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_multichannel_enquiry_list" model="ir.ui.view">
        <field name="name">multichannel.enquiry.list</field>
        <field name="model">multichannel.enquiry</field>
        <field name="arch" type="xml">
            <list string="Customer Enquiries"
                  decoration-info="state == 'new'"
                  decoration-success="state == 'qualified'"
                  decoration-muted="state in ('converted', 'closed')">
                <field name="name"/>
                <field name="partner_email"/>
                <field name="partner_id" optional="show"/>
                <field name="source"/>
                <field name="state"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="converted_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_multichannel_enquiry_kanban" model="ir.ui.view">
        <field name="name">multichannel.enquiry.kanban</field>
        <field name="model">multichannel.enquiry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_email"/>
                <field name="source"/>
                <field name="assigned_user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>
                                <field name="partner_email"/>
                            </div>
                            <div class="text-muted">
                                <field name="source"/>
                                <span t-if="record.assigned_user_id.value">
                                    · <field name="assigned_user_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_multichannel_enquiry_search" model="ir.ui.view">
        <field name="name">multichannel.enquiry.search</field>
        <field name="model">multichannel.enquiry</field>
        <field name="arch" type="xml">
            <search string="Search Enquiries">
                <field name="name"/>
                <field name="partner_email"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <separator/>
                <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                <filter string="Qualified" name="state_qualified" domain="[('state', '=', 'qualified')]"/>
                <filter string="Converted" name="state_converted" domain="[('state', '=', 'converted')]"/>
                <filter string="Closed" name="state_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Etsy API" name="source_etsy_api" domain="[('source', '=', 'etsy_api')]"/>
                <filter string="Email Alias" name="source_email_alias" domain="[('source', '=', 'email_alias')]"/>
                <filter string="Manual" name="source_manual" domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter string="Assigned to me" name="my_enquiries"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                <filter string="Assigned User" name="group_assigned" context="{'group_by': 'assigned_user_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_multichannel_enquiry" model="ir.actions.act_window">
        <field name="name">Customer Enquiries</field>
        <field name="res_model">multichannel.enquiry</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_multichannel_enquiry_search"/>
        <field name="context">{'search_default_state_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer enquiries yet.
            </p><p>
                Pre-sale enquiries arrive via the Etsy Conversations API,
                per-shop email aliases, or are entered manually.
            </p>
        </field>
    </record>

    <!-- Menu entry under Operations -->
    <menuitem id="menu_multichannel_enquiry"
              name="Customer Enquiries"
              parent="menu_operations_root"
              action="action_multichannel_enquiry"
              sequence="40"/>

</odoo>

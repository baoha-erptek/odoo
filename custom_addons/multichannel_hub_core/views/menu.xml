<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- P1-01a — Operations top-level menu hosting the unified
         Operations Dashboard (P1-DASH-MERGE) and the future Process
         Dashboard (P2-03). -->
    <menuitem id="menu_operations_root"
              name="Operations"
              sequence="20"
              groups="sales_team.group_sale_salesman"/>

    <!-- P-IA-01 — workflow-grouped hub sections (owner-approved
         v2-uiux-improved IA). Sections carry no action: Odoo hides a section
         when the user can see none of its children, so leaf-level groups=
         drive visibility. Labels stay English in XML; Vietnamese comes from
         i18n/vi.po. Menus in etsy_integration / multichannel_hub_fulfillment
         / design re-parent onto these ids (they all depend on this module). -->
    <menuitem id="menu_daily_work"
              name="Daily Work"
              parent="menu_operations_root"
              sequence="10"/>

    <menuitem id="menu_sales_publish"
              name="Sales &amp; Publish"
              parent="menu_operations_root"
              sequence="20"/>

    <menuitem id="menu_fulfillment"
              name="Fulfillment"
              parent="menu_operations_root"
              sequence="30"/>

    <menuitem id="menu_after_sales"
              name="After-Sales"
              parent="menu_operations_root"
              sequence="40"/>

    <menuitem id="menu_monitoring"
              name="Monitoring"
              parent="menu_operations_root"
              sequence="50"/>

    <!-- P1-DASH-MERGE — single Operations Dashboard menu, now first Daily
         Work entry. Replaces the original P1-01a menu_order_dashboard
         and the P1-03 menu_tracking_dashboard which are deleted below
         per CEO directive 2026-05-03. -->
    <menuitem id="menu_operations_dashboard"
              name="Operations Dashboard"
              parent="menu_daily_work"
              action="action_operations_dashboard"
              sequence="10"/>

    <!-- P1-01b — Legacy fallback menu (R-2026-05-10 mitigation).
         Recreates the previous sale.order list under Operations
         → Legacy → Order View (P1-01a) so operators have a familiar
         fallback during P1-01b UAT.
         TODO: remove after 2026-05-24 staging UAT sign-off (one sprint). -->
    <record id="action_operations_dashboard_legacy_orders" model="ir.actions.act_window">
        <field name="name">Order View (P1-01a Legacy)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                P1-01a fallback view (sale.order list). Removed after
                2026-05-24 once P1-01b UAT signs off. Use the new
                Operations Dashboard for daily work.
            </p>
        </field>
    </record>

    <menuitem id="menu_operations_legacy"
              name="Legacy"
              parent="menu_operations_root"
              sequence="90"
              groups="multichannel_hub_core.group_ba_lead"/>

    <menuitem id="menu_operations_dashboard_legacy_orders"
              name="Order View (P1-01a)"
              parent="menu_operations_legacy"
              action="action_operations_dashboard_legacy_orders"
              sequence="10"
              groups="multichannel_hub_core.group_ba_lead"/>

    <!-- Explicit deletes so env.ref() returns falsy after upgrade —
         Odoo does not auto-purge ir_model_data rows when XML is
         removed from a module's data list. -->
    <!-- Idempotent cleanup of legacy P1-DASH-MERGE orphans. On envs that never
         had these xmlids (e.g. staging deployed after the merge), <delete
         id="..."> raises; search+unlink is a no-op on empty recordsets. -->
    <function name="unlink" model="ir.model.data">
      <function name="search" model="ir.model.data">
        <value eval="[('module', '=', 'multichannel_hub_core'),
                      ('name', 'in', ['menu_order_dashboard',
                                      'menu_tracking_dashboard',
                                      'action_order_dashboard',
                                      'action_tracking_dashboard',
                                      'order_dashboard_list_view',
                                      'view_tracking_dashboard_list',
                                      'view_tracking_dashboard_search'])]"/>
      </function>
    </function>
</odoo>

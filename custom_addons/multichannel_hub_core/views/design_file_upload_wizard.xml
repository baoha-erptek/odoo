<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- design.file.upload.wizard form view -->
        <record id="design_file_upload_wizard_form" model="ir.ui.view">
            <field name="name">design.file.upload.wizard.form</field>
            <field name="model">design.file.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload Design File to Google Drive">
                    <group>
                        <field name="order_line_id" readonly="1" />
                        <field name="file_name" required="1" />
                        <field name="design_file" required="1" widget="binary" />
                    </group>
                    <footer>
                        <button name="action_upload" type="object" string="Upload" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard action (launched from sale.order.line button) -->
        <record id="action_design_file_upload_wizard" model="ir.actions.act_window">
            <field name="name">Upload to Google Drive</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">design.file.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="design_file_upload_wizard_form" />
            <field name="target">new</field>
            <field name="binding_model_id" ref="sale.model_sale_order_line" />
        </record>
    </data>
</odoo>

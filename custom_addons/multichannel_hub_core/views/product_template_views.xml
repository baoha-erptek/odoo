<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec 009 P-HUB-STATUS-VIEW T034 — Channels tab + smart button on product form. -->

    <record id="product_template_form_hub_status_tab" model="ir.ui.view">
        <field name="name">product.template.form.hub.status.tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_channel_statuses"
                        icon="fa-rss">
                    <field name="x_published_channel_count" widget="statinfo"
                           string="Published"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Channels" name="hub_channels">
                    <group>
                        <field name="x_channel_applicability_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <field name="x_sales_channel_status_ids" readonly="True">
                        <list>
                            <field name="channel_id"/>
                            <field name="state"/>
                            <field name="external_ref"/>
                            <field name="last_sync_at"/>
                        </list>
                    </field>
                </page>
                <page string="SKU Drift" name="hub_sku_drift">
                    <group>
                        <field name="x_sku_v2_suggested" readonly="True"/>
                        <field name="x_sku_v2_status" readonly="True"/>
                        <field name="x_sku_legacy" readonly="True"/>
                        <!-- Tracks the last system-derived code so the auto-fill
                             onchange can tell auto from manual. Must be in the arch
                             (invisible) to round-trip across onchange calls. -->
                        <field name="x_sku_auto_value" invisible="1"/>
                    </group>
                </page>
                <page string="Listing Tags" name="hub_listing_tags">
                    <group>
                        <field name="product_tag_ids" widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               help="Up to 13 tags, each &lt;=20 chars, charset [A-Za-z0-9 -']. Used by Etsy publisher."/>
                    </group>
                </page>
                <page string="Listing Options" name="hub_listing_options">
                    <group>
                        <field name="x_is_personalizable"/>
                        <field name="x_personalization_required"
                               invisible="not x_is_personalizable"/>
                        <field name="x_personalization_char_count"
                               invisible="not x_is_personalizable"/>
                    </group>
                    <field name="x_personalization_instructions"
                           invisible="not x_is_personalizable"
                           placeholder="e.g., 'Enter recipient name for engraving'"/>
                </page>
                <page string="Listing Defaults" name="hub_listing_defaults">
                    <group>
                        <field name="x_taxonomy_id"
                               placeholder="Leave blank to use shop default"/>
                        <field name="x_who_made"
                               placeholder="Leave blank to use shop default"/>
                        <field name="x_when_made"
                               placeholder="Leave blank to use shop default"/>
                    </group>
                </page>
                <page string="Extra Images" name="hub_extra_images">
                    <field name="x_extra_image_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- P-DS-2-MVP-BACKPORT — Tier 3 visibility model per
                 docs/FORM_CURATION_GUIDE.md.  Hides technical fields behind
                 `groups="base.group_no_one"` (developer mode only) so BA /
                 BA Lead Marketing see a focused product form.  Reversible
                 by toggling developer mode.  Fields targeted here all live
                 in product.product_template_form_view (the parent of this
                 inherit). -->

            <xpath expr="//field[@name='product_tooltip']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <!-- standard_price is admin/cost-sensitive — keep visible to sys
                 admins, not just developers (per FORM_CURATION_GUIDE rule
                 "Tier 3 = behind group OR invisible with clear reason"). -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">base.group_system</attribute>
            </xpath>
        </field>
    </record>

    <!-- P-DS-2-MVP-BACKPORT — Tier 3 + .mu-mono SKU on the secondary
         product_template_only_form_view (where default_code + barcode live,
         per addons/product/views/product_template_views.xml:55+). -->
    <record id="product_template_only_form_view_hub_tier3" model="ir.ui.view">
        <field name="name">product.template.only.form.hub.tier3</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="class">mu-mono</attribute>
            </xpath>
        </field>
    </record>

    <!-- Phase C — product.template Tier-3 curation (Flow 1 mockup screen 1).
         Hides per-module *setup* clutter from BA / BA-Lead-Marketing users so
         the product form stays focused on the Etsy publish narrative.  All
         hiding is via groups="base.group_no_one" (developer mode only), so
         it is fully reversible by toggling developer mode and never removes a
         capability for users who actually need it.  Targets the stock-owned
         nodes directly (mhc already depends on `stock`) rather than xpath-ing
         across sibling inherits.  weight/volume and the customer lead time
         (sale_delay) stay visible — Etsy/dropship need physical dimensions
         and fulfillment SLAs.  See MOCKUP_product_template.md §5.b. -->
    <record id="product_template_form_view_stock_tier3" model="ir.ui.view">
        <field name="name">product.template.form.stock.tier3</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <!-- Routes / MTO / Dropship buy-sell config (per-module setup). -->
            <xpath expr="//group[@name='operations']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <!-- Warehouse receipt / delivery note blocks (not Etsy-relevant).
                 The wrapping groups carry no name= selector, so reach them via
                 their note field (string= is rejected as an inherit selector). -->
            <xpath expr="//field[@name='description_pickingin']/parent::group" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//field[@name='description_pickingout']/parent::group" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
        </field>
    </record>

    <!-- Phase C — hide the inventory Responsible (a per-product owner the BA
         does not set) on the procurement-button inherit where it lives. -->
    <record id="product_template_form_view_procurement_tier3" model="ir.ui.view">
        <field name="name">product.template.form.procurement.tier3</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='responsible_id']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
        </field>
    </record>
</odoo>

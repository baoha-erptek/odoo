<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- P1-03 — Tracking Dashboard for shipping-ops (Spec 003 US2). -->

    <!-- List view: 13 columns per spec acceptance. -->
    <record id="view_tracking_dashboard_list" model="ir.ui.view">
        <field name="name">sale.order.fulfillment.tracking.dashboard.list</field>
        <field name="model">sale.order.fulfillment</field>
        <field name="arch" type="xml">
            <list string="Tracking Dashboard"
                  decoration-warning="order_address_change_pending"
                  decoration-info="order_priority == 'push'"
                  decoration-danger="order_priority == 'urgent'"
                  default_order="shipping_date desc, id desc">
                <!-- Odoo 19 OWL: dotted-field references in decoration
                     attributes need the field LOADED on the record.
                     `order_address_change_pending` is the related Boolean
                     declared on sale.order.fulfillment so the list can
                     read it via web_search_read without a sale.order
                     round-trip. -->
                <field name="order_address_change_pending" column_invisible="1"/>
                <field name="order_id"/>
                <field name="order_id" string="Buyer"
                       widget="many2one_avatar_user" optional="hide"/>
                <field name="tracking_number"/>
                <field name="shipping_carrier_id"/>
                <field name="shipping_date"/>
                <field name="label_status" widget="badge"
                       decoration-success="label_status == 'bought'"
                       decoration-warning="label_status == 'requested'"
                       decoration-danger="label_status == 'failed'"/>
                <field name="tracking_state" widget="badge"
                       decoration-success="tracking_state == 'delivered'"
                       decoration-info="tracking_state in ('shipped','in_transit')"
                       decoration-warning="tracking_state == 'returned'"/>
                <field name="warehouse_zone"/>
                <field name="order_priority" widget="badge"
                       decoration-info="order_priority == 'push'"
                       decoration-danger="order_priority == 'urgent'"/>
                <field name="production_blocked" optional="show"/>
                <field name="block_reason" optional="hide"/>
                <field name="pic_user_id" optional="hide"/>
                <field name="pd_pic_user_id" optional="hide"/>
                <field name="pd_note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search view: filters + group-by per FR-007. -->
    <record id="view_tracking_dashboard_search" model="ir.ui.view">
        <field name="name">sale.order.fulfillment.tracking.dashboard.search</field>
        <field name="model">sale.order.fulfillment</field>
        <field name="arch" type="xml">
            <search string="Tracking Dashboard">
                <field name="tracking_number"/>
                <field name="order_id"/>
                <field name="shipping_carrier_id"/>
                <field name="pic_user_id"/>
                <separator/>
                <filter string="Production Blocked" name="filter_blocked"
                        domain="[('production_blocked', '=', True)]"/>
                <filter string="Label Bought" name="filter_label_bought"
                        domain="[('label_status', '=', 'bought')]"/>
                <filter string="Shipped" name="filter_shipped"
                        domain="[('tracking_state', '=', 'shipped')]"/>
                <filter string="Delivered" name="filter_delivered"
                        domain="[('tracking_state', '=', 'delivered')]"/>
                <separator/>
                <filter string="VN Warehouse" name="filter_vn"
                        domain="[('warehouse_zone', '=', 'vn')]"/>
                <filter string="US Warehouse" name="filter_us"
                        domain="[('warehouse_zone', '=', 'us')]"/>
                <separator/>
                <filter string="Carrier" name="group_carrier"
                        context="{'group_by': 'shipping_carrier_id'}"/>
                <filter string="Label Status" name="group_label_status"
                        context="{'group_by': 'label_status'}"/>
                <filter string="Tracking State" name="group_tracking_state"
                        context="{'group_by': 'tracking_state'}"/>
                <filter string="Warehouse" name="group_warehouse"
                        context="{'group_by': 'warehouse_zone'}"/>
                <filter string="Priority" name="group_priority"
                        context="{'group_by': 'order_priority'}"/>
            </search>
        </field>
    </record>

    <!-- Action window. -->
    <record id="action_tracking_dashboard" model="ir.actions.act_window">
        <field name="name">Tracking Dashboard</field>
        <field name="res_model">sale.order.fulfillment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tracking_dashboard_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fulfillments yet — orders confirmed via the Order Dashboard
                will appear here for tracking and shipping management.
            </p>
        </field>
    </record>

    <!-- Bulk Mark Shipped server action (T035 + T061). -->
    <record id="action_server_bulk_mark_shipped" model="ir.actions.server">
        <field name="name">Mark Shipped</field>
        <field name="model_id" ref="model_sale_order_fulfillment"/>
        <field name="binding_model_id" ref="model_sale_order_fulfillment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_mark_shipped()</field>
    </record>

    <!-- Menu under Operations. -->
    <menuitem id="menu_tracking_dashboard"
              name="Tracking Dashboard"
              parent="menu_operations_root"
              action="action_tracking_dashboard"
              sequence="20"/>
</odoo>

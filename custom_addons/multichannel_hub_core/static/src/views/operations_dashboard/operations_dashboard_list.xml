<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="multichannel_hub_core.OperationsDashboardListRenderer"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <OperationsKpiBand/>
        </xpath>
    </t>

    <t t-name="multichannel_hub_core.OperationsKpiBand">
        <div class="mu_kpi_band" t-if="state.kpis.length">
            <div class="mu_kpi_card" t-foreach="state.kpis" t-as="kpi"
                 t-key="kpi.key" t-att-data-kpi="kpi.key">
                <div class="mu_kpi_value" t-esc="kpi.value"/>
                <div class="mu_kpi_label" t-esc="kpi.label"/>
            </div>
        </div>
    </t>

</templates>

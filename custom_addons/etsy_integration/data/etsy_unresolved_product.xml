<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        FLW-03: shared placeholder for API-ingested order lines whose Etsy
        SKU could not be resolved to a product.product. The order is created
        (no data loss) but held via production_blocked until an operator maps
        the line to the right variant and swaps the product.
        Service type: no stock move / no procurement while unresolved.
    -->
    <record id="product_etsy_unresolved" model="product.template">
        <field name="name">Etsy Unresolved Item</field>
        <field name="type">service</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="list_price">0.0</field>
        <field name="default_code">ETSY-UNRESOLVED</field>
        <field name="description_sale">Placeholder for an Etsy order line whose SKU did not match any product. Map the correct product, then unblock the order.</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_fetch_etsy_emails" model="ir.cron">
        <field name="name">Etsy: Fetch Order Emails</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_etsy_emails()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="cron_etsy_order_sync" model="ir.cron">
        <field name="name">Etsy: API Receipts Sync</field>
        <field name="model_id" ref="model_etsy_shop"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_orders()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_etsy_api_log_cleanup" model="ir.cron">
        <field name="name">Etsy: API Log Retention Sweep</field>
        <field name="model_id" ref="model_etsy_api_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

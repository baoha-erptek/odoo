<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Import Orders Wizard: Form View                               -->
    <!-- ============================================================ -->

    <record id="etsy_import_orders_wizard_view_form" model="ir.ui.view">
        <field name="name">etsy.import.orders.wizard.form</field>
        <field name="model">etsy.import.orders.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Etsy Orders">
                <group>
                    <group>
                        <field name="excel_file" filename="excel_filename" widget="binary"/>
                        <field name="excel_filename" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="status_text" readonly="1"/>
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import Orders"
                        class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

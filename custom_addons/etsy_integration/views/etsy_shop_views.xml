<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Etsy Shop: Tree View                                          -->
    <!-- ============================================================ -->

    <record id="etsy_shop_view_list" model="ir.ui.view">
        <field name="name">etsy.shop.list</field>
        <field name="model">etsy.shop</field>
        <field name="arch" type="xml">
            <list string="Etsy Shops">
                <field name="name"/>
                <field name="order_count"/>
                <field name="revenue_total" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Etsy Shop: Form View                                          -->
    <!-- ============================================================ -->

    <record id="etsy_shop_view_form" model="ir.ui.view">
        <field name="name">etsy.shop.form</field>
        <field name="model">etsy.shop</field>
        <field name="arch" type="xml">
            <form string="Etsy Shop">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button
                            name="action_authorize_etsy"
                            type="object"
                            string="Authorize Etsy"
                            class="oe_stat_button"
                            icon="fa-key"
                            groups="base.group_system"/>
                        <button
                            name="action_test_connection"
                            type="object"
                            string="Test Connection"
                            class="oe_stat_button"
                            icon="fa-plug"
                            groups="base.group_system"/>
                        <button
                            name="action_provision_enquiry_alias"
                            type="object"
                            string="Provision Email Alias"
                            class="oe_stat_button"
                            icon="fa-envelope"
                            groups="base.group_system"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Shop Name"/>
                        </h1>
                    </div>
                    <!-- P-DS-3a — Tier 1 essentials: shop identity + active
                         adapter + listing currency. Visible to anyone with
                         etsy.shop read ACL (sales + system). -->
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="revenue_total" widget="monetary"/>
                            <field name="listing_currency_id"/>
                        </group>
                        <group string="Etsy API Identity">
                            <field name="etsy_api_shop_id"
                                   class="mu-mono"
                                   placeholder="e.g. 60752333"/>
                            <field name="active_source"
                                   widget="badge"
                                   decoration-success="active_source == 'api'"
                                   decoration-warning="active_source == 'email'"/>
                        </group>
                    </group>
                    <!-- P-DS-3a — Tier 3 (dev-only) diagnostics. Hidden
                         behind base.group_no_one per PHASE_3_SCOPE.md and
                         owner gate (2026-06-07). Probe counters + audit
                         timestamp + auto-recovery toggle live here. -->
                    <group string="Advanced Diagnostics"
                           groups="base.group_no_one">
                        <field name="auto_recovery"/>
                        <field name="active_source_changed_at" readonly="1"/>
                        <field name="health_check_consecutive_failures"
                               readonly="1"/>
                        <field name="recovery_probe_consecutive_successes"
                               readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Publisher Defaults" name="publisher_defaults">
                            <group string="Etsy Publisher Defaults"
                                   groups="multichannel_hub_core.group_ba_user">
                                <field name="default_taxonomy_id"
                                       groups="base.group_system"/>
                                <field name="default_shipping_profile_id"
                                       groups="base.group_system"/>
                                <field name="default_return_policy_id"
                                       groups="base.group_system"/>
                                <field name="default_who_made"/>
                                <field name="default_when_made"/>
                                <field name="default_is_supply"/>
                            </group>
                            <!-- P-ENH-ESTY-190 / ADR-017 — shop-level
                                 brand-voice defaults. 3rd tier of the
                                 listing → product → shop chain. Empty
                                 fields continue the chain. -->
                            <group string="Shop Brand-Voice Defaults"
                                   groups="multichannel_hub_core.group_marketing_user">
                                <field name="default_title"
                                       placeholder="e.g. Handmade Ceramic by JaHandmadeArt"/>
                                <field name="default_description"
                                       placeholder="Per-shop fallback description; empty → product description_sale"/>
                                <field name="default_image_1920"
                                       widget="image"
                                       options="{'preview_image': 'default_image_1920'}"/>
                            </group>
                            <group string="Etsy Publisher Unit Preferences"
                                   groups="base.group_system">
                                <field name="weight_unit_pref"/>
                                <field name="dimensions_unit_pref"/>
                            </group>
                            <!-- P-LIST-ATTR-CONFIG / UX HIGH #4 — shop
                                 layer for attribute mapping. Tier-2 of the
                                 3-tier fallback chain. -->
                            <div class="alert alert-info" role="alert">
                                <strong>Attribute mapping priority:</strong>
                                Per-listing rows (on the Listing form) →
                                These shop defaults → Product global
                                (Product Attribute). Leave a row's override
                                empty to fall through to the next tier.
                            </div>
                            <field name="default_attribute_mapping_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_attribute_id"
                                           options="{'no_create': True}"/>
                                    <field name="etsy_property_id_override"
                                           placeholder="Numeric Etsy property_id"/>
                                    <field name="etsy_property_name_override"
                                           placeholder="Etsy property_name string"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Etsy Shop: Search View                                        -->
    <!-- ============================================================ -->

    <record id="etsy_shop_view_search" model="ir.ui.view">
        <field name="name">etsy.shop.search</field>
        <field name="model">etsy.shop</field>
        <field name="arch" type="xml">
            <search string="Search Etsy Shops">
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
            </search>
        </field>
    </record>

</odoo>

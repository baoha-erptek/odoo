<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Inherit product.template form: add Etsy image URL             -->
    <!-- ============================================================ -->

    <record id="view_product_template_form_etsy_inherit" model="ir.ui.view">
        <field name="name">product.template.form.etsy.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="after">
                <group string="Etsy" name="etsy_product_group" invisible="not is_etsy_product">
                    <field name="etsy_image_url" widget="url"/>
                    <field name="etsy_needs_product_review"/>
                    <field name="is_etsy_product" invisible="1"/>
                </group>
            </xpath>
            <!-- Spec 011 P-PUB-PUBLISH T027 — Publish to Etsy entry point on
                 the product form header. The button opens the publish wizard
                 which carries the FR-017 gate; this is UI-side defense-in-depth. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_etsy_publish_wizard" type="object"
                            string="Publish to Etsy" class="oe_highlight"
                            groups="multichannel_hub_core.group_ba_user"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Inherit product.template search: add Etsy Products filter     -->
    <!-- ============================================================ -->

    <record id="view_product_template_search_etsy_inherit" model="ir.ui.view">
        <field name="name">product.template.search.etsy.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='services']" position="after">
                <filter name="filter_etsy_products" string="Etsy Products" domain="[('is_etsy_product', '=', True)]"/>
                <filter name="filter_etsy_needs_product_review"
                        string="Needs Etsy Review"
                        domain="[('etsy_needs_product_review', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_tree_etsy_inherit" model="ir.ui.view">
        <field name="name">product.template.list.etsy.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="etsy_needs_product_review" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>

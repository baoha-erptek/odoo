<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Inherit sale.order form: add Etsy tab                         -->
    <!-- ============================================================ -->

    <record id="view_order_form_etsy_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.etsy.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- P1-04 T059: address-change banner + lock partner_shipping_id
                 while a request is pending. T060 ("Request address change"
                 button) lands with the Order Dashboard in P1-01. -->
            <xpath expr="//sheet" position="inside">
                <field name="has_pending_address_change" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not has_pending_address_change">
                    <strong>Address change pending approval.</strong>
                    Shipping fields are locked until a BA Lead resolves
                    the open address-change request.
                </div>
            </xpath>

            <!-- T060: "Request address change" button — visible to MP
                 + BA + sales-user when no request is pending. -->
            <xpath expr="//header" position="inside">
                <button name="action_request_address_change"
                        type="object"
                        string="Request address change"
                        invisible="has_pending_address_change or not is_etsy_order"
                        class="btn-secondary"/>
                <!-- P1-12 T036: on-demand tracking push (manual retry;
                     webhook per D-A is the primary trigger). Restricted
                     to the production/fulfillment team — the action
                     triggers an authenticated external Etsy API call
                     using system OAuth tokens (security review HIGH). -->
                <button name="action_push_tracking_to_etsy"
                        type="object"
                        string="Push tracking to Etsy"
                        invisible="not is_etsy_order"
                        groups="multichannel_hub_core.group_production_team"
                        class="btn-secondary"/>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">has_pending_address_change</attribute>
            </xpath>

            <!-- Add Etsy notebook page before the closing notebook tag -->
            <xpath expr="//notebook" position="inside">
                <page string="Etsy" name="etsy_tab" invisible="not is_etsy_order">
                    <group>
                        <group string="Etsy Order">
                            <field name="is_etsy_order" invisible="1"/>
                            <field name="etsy_order_id"/>
                            <field name="etsy_shop_id"/>
                            <field name="etsy_email_log_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Shipping">
                            <field name="etsy_shipping_service"/>
                            <field name="etsy_processing_time"/>
                            <field name="etsy_shipping_cost"/>
                        </group>
                        <group string="Pricing">
                            <field name="etsy_discount_code"/>
                            <field name="etsy_discount_amount" readonly="1"/>
                            <field name="etsy_subtotal"/>
                            <field name="etsy_tax_total" readonly="1"/>
                            <field name="etsy_gift_wrap_price" readonly="1"/>
                            <field name="etsy_needs_gift_wrap" readonly="1"/>
                        </group>
                        <group string="Receipt Status">
                            <field name="etsy_receipt_status" readonly="1"/>
                            <field name="etsy_is_shipped" readonly="1"/>
                            <field name="etsy_total_mismatch" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Notes">
                            <field name="etsy_note_from_buyer"/>
                            <field name="etsy_gift_message"/>
                        </group>
                    </group>
                    <!--
                        P4-01-D D4 — read-only Shipping Tracking subsection.
                        Surfaces existing sale.order.fulfillment fields
                        (delegated via P1-05 _inherits) inside the Etsy tab.
                        No new fields, no Etsy-outbound API push — just makes
                        tracking data discoverable in the operator's natural
                        workspace. Owner D4: smallest blast radius.
                    -->
                    <group>
                        <group string="Shipping Tracking">
                            <field name="tracking_number" readonly="1"/>
                            <field name="shipping_carrier_id" readonly="1"/>
                            <field name="tracking_state" readonly="1"/>
                            <field name="shipping_date" readonly="1"/>
                            <field name="tracking_url" readonly="1"
                                   widget="url"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Add Etsy columns to the order line tree -->
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                <field name="etsy_transaction_id" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_personalisation" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_color" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_size" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_option" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_side" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_face_mask_size" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_image_url" optional="hide" column_invisible="not parent.is_etsy_order"/>
            </xpath>

            <!-- P1-IMG-LINE-WIDGET: product image thumbnail column on order-line list.
                 Channel-agnostic; visible for all order lines on this form.
                 Placed BEFORE product_id (deliberate deviation from plan's "after")
                 so the image is the leftmost visual anchor — matches Odoo's stock
                 product-list convention where the image column leads the row. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
                <field name="product_image_thumb" widget="image" readonly="1" optional="show" string="Image"/>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_with_onboarding_etsy_pull" model="ir.ui.view">
        <field name="name">sale.order.quotation.list.etsy.pull</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <!-- Swap the onboarding list js_class for our extension, which adds
                 an always-visible "Pull Etsy Orders" control-panel button (next
                 to "New"). A list <header> button only renders in the row-
                 selection action bar and is unreachable on an empty list, so it
                 was the wrong placement for a global pull action. etsy_pull_list
                 spreads sale_onboarding_list, so onboarding behaviour stays. -->
            <list position="attributes">
                <attribute name="js_class">etsy_pull_list</attribute>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Inherit sale.order search: add Etsy filters                   -->
    <!-- ============================================================ -->

    <record id="view_sales_order_filter_etsy_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.etsy.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="filter_etsy_orders" string="Etsy Orders" domain="[('is_etsy_order', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="groupby_etsy_shop" string="Etsy Shop" context="{'group_by': 'etsy_shop_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>

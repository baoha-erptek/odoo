<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Inherit sale.order form: add Etsy tab                         -->
    <!-- ============================================================ -->

    <record id="view_order_form_etsy_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.etsy.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- P1-04 T059: address-change banner + lock partner_shipping_id
                 while a request is pending. T060 ("Request address change"
                 button) lands with the Order Dashboard in P1-01. -->
            <xpath expr="//sheet" position="inside">
                <field name="has_pending_address_change" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not has_pending_address_change">
                    <strong>Address change pending approval.</strong>
                    Shipping fields are locked until a BA Lead resolves
                    the open address-change request.
                </div>
            </xpath>

            <!-- T060: "Request address change" button — visible to MP
                 + BA + sales-user when no request is pending. -->
            <xpath expr="//header" position="inside">
                <button name="action_request_address_change"
                        type="object"
                        string="Request address change"
                        invisible="has_pending_address_change or not is_etsy_order"
                        class="btn-secondary"/>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">has_pending_address_change</attribute>
            </xpath>

            <!-- Add Etsy notebook page before the closing notebook tag -->
            <xpath expr="//notebook" position="inside">
                <page string="Etsy" name="etsy_tab" invisible="not is_etsy_order">
                    <group>
                        <group string="Etsy Order">
                            <field name="is_etsy_order" invisible="1"/>
                            <field name="etsy_order_id"/>
                            <field name="etsy_shop_id"/>
                            <field name="etsy_email_log_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Shipping">
                            <field name="etsy_shipping_service"/>
                            <field name="etsy_processing_time"/>
                            <field name="etsy_shipping_cost"/>
                        </group>
                        <group string="Pricing">
                            <field name="etsy_discount_code"/>
                            <field name="etsy_subtotal"/>
                        </group>
                    </group>
                    <group>
                        <group string="Notes">
                            <field name="etsy_note_from_buyer"/>
                            <field name="etsy_gift_message"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Add Etsy columns to the order line tree -->
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                <field name="etsy_transaction_id" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_personalisation" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_color" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_size" optional="hide" column_invisible="not parent.is_etsy_order"/>
                <field name="etsy_option" optional="hide" column_invisible="not parent.is_etsy_order"/>
            </xpath>

            <!-- P1-IMG-LINE-WIDGET: product image thumbnail column on order-line list.
                 Channel-agnostic; visible for all order lines on this form.
                 Placed BEFORE product_id (deliberate deviation from plan's "after")
                 so the image is the leftmost visual anchor — matches Odoo's stock
                 product-list convention where the image column leads the row. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
                <field name="product_image_thumb" widget="image" readonly="1" optional="show" string="Image"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Inherit sale.order search: add Etsy filters                   -->
    <!-- ============================================================ -->

    <record id="view_sales_order_filter_etsy_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.etsy.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="filter_etsy_orders" string="Etsy Orders" domain="[('is_etsy_order', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="groupby_etsy_shop" string="Etsy Shop" context="{'group_by': 'etsy_shop_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etsy_data_migration_wizard_form" model="ir.ui.view">
        <field name="name">etsy.data.migration.wizard.form</field>
        <field name="model">etsy.data.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Etsy Data Migration">
                <sheet>
                    <div class="oe_title">
                        <h1>Etsy Data Migration</h1>
                        <p>Backbone wizard for the 17K-order remediation pass.
                           Each option below is independently toggleable; the
                           run is resumable via the checkpoint field.</p>
                    </div>
                    <notebook>
                        <page string="Input &amp; Checkpoint">
                            <group>
                                <group string="Source data (optional)">
                                    <field name="excel_file" filename="excel_filename"/>
                                    <field name="excel_filename" invisible="1"/>
                                </group>
                                <group string="Resumability (R4)">
                                    <field name="resume_from_checkpoint"/>
                                    <field name="batch_size"/>
                                    <field name="last_processed_id"/>
                                </group>
                                <group string="Anomalies (R9)">
                                    <field name="include_anomalies"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fix Options">
                            <group>
                                <group string="Order fixes">
                                    <field name="fix_financial_config"/>
                                    <field name="fix_shipping_lines"/>
                                    <field name="fix_product_config"/>
                                    <field name="auto_confirm"/>
                                </group>
                                <group string="Partner dedup (R10)">
                                    <field name="generate_dedup_report"/>
                                    <field name="approved_merges_file"
                                           filename="approved_merges_filename"
                                           help="Upload BA-approved CSV (from a prior run with 'Generate dedup CSV' enabled) before clicking 'Apply Merges'."/>
                                    <field name="approved_merges_filename"
                                           invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Results">
                            <group>
                                <field name="sync_health_id" readonly="1"/>
                                <field name="status_message" readonly="1" nolabel="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_migrate"
                            string="Run Migration"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_apply_merges"
                            string="Apply Merges"
                            type="object"/>
                    <button string="Close"
                            class="oe_link"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Surface Etsy-specific fields on the multichannel.enquiry form when
         etsy_integration is installed. mhc cannot reference etsy.shop per
         ADR-003. -->
    <record id="view_multichannel_enquiry_form_etsy" model="ir.ui.view">
        <field name="name">multichannel.enquiry.form.etsy</field>
        <field name="model">multichannel.enquiry</field>
        <field name="inherit_id" ref="multichannel_hub_core.view_multichannel_enquiry_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_user_id']" position="before">
                <field name="etsy_shop_id"
                       invisible="source != 'etsy_api'"/>
                <field name="etsy_conversation_id"
                       invisible="source != 'etsy_api'"/>
            </xpath>
        </field>
    </record>

    <!-- Add etsy_conversation_id to the search view -->
    <record id="view_multichannel_enquiry_search_etsy" model="ir.ui.view">
        <field name="name">multichannel.enquiry.search.etsy</field>
        <field name="model">multichannel.enquiry</field>
        <field name="inherit_id" ref="multichannel_hub_core.view_multichannel_enquiry_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject']" position="after">
                <field name="etsy_conversation_id"/>
            </xpath>
        </field>
    </record>

</odoo>

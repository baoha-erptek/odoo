# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json
# project-scoped Claude Code config (agents, skills, rules, hooks)
!.claude/
# per-machine permissions — keep out of version control
.claude/settings.local.json
# runtime lock for /loop scheduled tasks
.claude/scheduled_tasks.lock
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# Project E2E test infrastructure overrides the upstream Odoo CE ignores
!tests/e2e/package.json
!tests/e2e/package-lock.json
!tests/e2e/tsconfig.json
!tests/e2e/playwright.config.ts

# UAT image fixtures — regenerate from the catalog xlsx via
# tests/e2e/fixtures/extract_catalog_images.py (do not commit ~1MB base64 photos)
tests/e2e/fixtures/assets/*.b64

# Versioned git hooks (cross-team automation; activate via core.hooksPath)
!.githooks/
!.githooks/**

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/

# Enterprise modules (downloaded separately, not committed)
enterprise/
enterprise.zip

secrets/
.env
.env.*
!.env.example

# claude-mem auto-generated activity trackers
custom_addons/**/CLAUDE.md
specs/**/CLAUDE.md

# Host-specific TFV parallel-deployment configs (separate Odoo instance, not part of esty repo)
deployment/*.tfv.*
deployment/scripts/deploy-tfv.sh
deployment/docker-compose.tfv.yml
deployment/nginx-tfv.*.conf

# Vendor module zips (download fresh from upstream, do not commit)
*.zip
!enterprise.zip

# graphify analysis output (tooling artefact, not source)
graphify-out/
.gstack/

# Gearment doc crawl — raw HTML snapshots (curated .md is committed; raw is not)
docs/vendor/gearment/_raw/
docs/vendor/**/*.tmp

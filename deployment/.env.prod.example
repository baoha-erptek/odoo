# Odoo 19 Namco - Production Environment
# Copy to .env and fill in real values

# Container
CONTAINER_NAME=namco_odoo19
IMAGE_TAG=latest

# Database (via PgBouncer on .241)
DB_HOST=192.168.1.241
DB_PORT=6432
DB_NAME=namco_odoo19
DB_FILTER=^namco_odoo19$
LIST_DB=False
DB_USER=namco_dbuser
DB_PASSWORD=CHANGE_ME
DB_MAXCONN=32

# Odoo Server (ports MUST NOT conflict with Odoo 15's 8069/8072)
ODOO_WORKERS=4
MAX_CRON_THREADS=1
ADMIN_PASSWORD=CHANGE_ME

# Logging
LOG_HANDLER=:WARNING
LOG_LEVEL=info
LOG_FILE=/var/log/odoo/odoo-server.log
LOG_ROTATE=True

# Resource Limits (conservative -- sharing .240 with Odoo 15)
# 6GB soft / 8GB hard (Odoo 15 uses ~20GB of the 32GB server)
LIMIT_MEMORY_HARD=8589934592
LIMIT_MEMORY_SOFT=6442450944
LIMIT_TIME_REAL=3600

# Volume Paths (separate from Odoo 15)
ODOO_DATA_DIR=/odoo/namco19/.local/share/Odoo
ODOO_BACKUP_DIR=/odoo/namco19/backups
ODOO_LOG_DIR=/var/log/odoo19
ODOO_CONF=./odoo-server.conf

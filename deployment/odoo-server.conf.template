# Odoo 19 Namco - Server Configuration Template
#
# Environment variable substitution via Python regex (NOT envsubst):
#   python3 -c 'import os,re; ...' (see deploy.sh)
#
# Port allocation: 8169 (HTTP) + 8172 (WebSocket)
# Odoo 15 uses:    8069 (HTTP) + 8072 (longpolling)

[options]
addons_path = /opt/odoo/odoo/addons,/opt/odoo/addons,/opt/odoo/enterprise,/opt/odoo/custom_addons
admin_passwd = ${ADMIN_PASSWORD:-adminadmin}
csv_internal_sep = ,
data_dir = /var/lib/odoo

# Database -- connects via PgBouncer (port 6432), NOT direct PostgreSQL (5432)
db_host = ${DB_HOST}
db_maxconn = ${DB_MAXCONN:-32}
db_name = ${DB_NAME}
db_password = ${DB_PASSWORD}
db_port = ${DB_PORT:-6432}
db_sslmode = prefer
db_template = template0
db_user = ${DB_USER}
dbfilter = ${DB_FILTER}

# Demo Data
without_demo = all

# Email
email_from = False
from_filter = False

# HTTP -- ports must NOT conflict with Odoo 15 (8069/8072)
http_enable = True
http_interface = 0.0.0.0
http_port = 8169
gevent_port = 8172
proxy_mode = True

# Resource Limits (conservative -- sharing .240 with Odoo 15)
limit_memory_hard = ${LIMIT_MEMORY_HARD:-8589934592}
limit_memory_soft = ${LIMIT_MEMORY_SOFT:-6442450944}
limit_request = 8192
limit_time_cpu = 1800
limit_time_real = ${LIMIT_TIME_REAL:-3600}
limit_time_real_cron = -1

# Database Listing (False for production)
list_db = ${LIST_DB:-False}

# Logging
log_db = False
log_db_level = warning
log_handler = ${LOG_HANDLER:-:WARNING}
log_level = ${LOG_LEVEL:-warning}
logfile = ${LOG_FILE:-}
logrotate = ${LOG_ROTATE:-False}

# Cron & Workers (conservative for parallel operation)
max_cron_threads = ${MAX_CRON_THREADS:-1}
workers = ${ODOO_WORKERS:-4}

# Server-wide modules (Odoo 19 defaults -- no queue_job)
server_wide_modules = base,rpc,web

# Enterprise
default_productivity_apps = True

# SMTP
smtp_password = False
smtp_port = 25
smtp_server = localhost
smtp_ssl = False
smtp_user = False

# Misc
osv_memory_count_limit = 0
pg_path =
test_enable = False
transient_age_limit = 1.0
unaccent = False
